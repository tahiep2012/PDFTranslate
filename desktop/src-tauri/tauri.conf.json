{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDFMathTranslate",
  "version": "1.0.10",
  "identifier": "com.pdfmathtranslate.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PDFMathTranslate - Dịch Thuật PDF Khoa Học",
        "width": 1200,
        "height": 820,
        "minWidth": 950,
        "minHeight": 650,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
